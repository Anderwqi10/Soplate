# Copia este archivo a .env y completa los valores. .env NO se versiona.
# Genera la clave con: backend\venv\Scripts\python.exe -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Solo en producción (DJANGO_DEBUG=false):
DJANGO_ALLOWED_HOSTS=mi-pc.tailnet-name.ts.net,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://mi-pc.tailnet-name.ts.net
DJANGO_CORS_ORIGINS=https://mi-pc.tailnet-name.ts.net

DATABASE_NAME=soplate_dev
DATABASE_USER=soplate
DATABASE_PASSWORD=cambia-esta-clave
DATABASE_HOST=localhost
DATABASE_PORT=5432

BACKUP_DIR=C:\soplate-backups
BACKUP_USB_DIR=E:\soplate-backups
# Carpeta con pg_dump / pg_restore (opcional si ya están en el PATH)
PG_BIN_DIR=C:\Program Files\PostgreSQL\17\bin
